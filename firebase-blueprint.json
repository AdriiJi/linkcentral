{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "Item": {
      "title": "Item",
      "description": "A link, group, or image item in LinkCentral",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique item ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "parentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Parent group ID or empty string"
        },
        "type": {
          "type": "string",
          "enum": ["link", "group", "image", "note"],
          "description": "Type of item"
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "description": "Name or title"
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "description": "Destination URL"
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "description": "Description text or caption"
        },
        "color": {
          "type": "string",
          "maxLength": 50,
          "description": "Color identifier or hex"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether pinned to top"
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        },
        "imageId": {
          "type": "string",
          "maxLength": 128,
          "description": "Associated image storage id"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp ms"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "type", "name", "order"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User UI preferences such as theme and colors",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "Color theme"
        },
        "headerButtonsOrder": {
          "type": "string",
          "maxLength": 500,
          "description": "Serialized button order"
        },
        "customColors": {
          "type": "string",
          "maxLength": 2000,
          "description": "Serialized custom colors"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User root document"
    },
    "/users/{userId}/items/{itemId}": {
      "schema": "Item",
      "description": "User items (links, groups, images)"
    },
    "/users/{userId}/settings/preferences": {
      "schema": "UserPreferences",
      "description": "User layout and theme preferences"
    }
  }
}
